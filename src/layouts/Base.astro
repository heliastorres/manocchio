---
import '../styles/global.css';
import { conteudo } from '../data/conteudo';

const { site, acessibilidade } = conteudo;
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.descricao} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{site.titulo}</title>
    <!-- Marca que o JavaScript está ativo: só então as partes da página começam escondidas e entram ao rolar -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="bg-preto font-texto text-preto antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-preto focus:px-4 focus:py-2 focus:text-branco"
    >
      {acessibilidade.pularParaConteudo}
    </a>
    <slot />
  </body>
</html>

<script>
  // ENTRADA DAS PARTES: cada elemento com data-revelar aparece uma vez, ao entrar na tela,
  // com um pequeno atraso por posição dentro da seção (título, texto, foto, um depois do outro).
  const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const itens = Array.from(document.querySelectorAll<HTMLElement>('[data-revelar]'));

  if (reduzir || !('IntersectionObserver' in window)) {
    itens.forEach((el) => el.classList.add('visivel'));
  } else {
    const contagem = new Map<Element, number>();
    itens.forEach((el) => {
      const secao = el.closest('section') ?? document.body;
      const n = contagem.get(secao) ?? 0;
      contagem.set(secao, n + 1);
      el.style.setProperty('--atraso', `${Math.min(n, 5) * 80}ms`);
    });
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visivel');
            observador.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    itens.forEach((el) => observador.observe(el));
  }

  // A foto da chamada principal desliza devagar quando a página rola (paralaxe leve).
  const deslizante = document.querySelector<HTMLElement>('[data-paralaxe]');
  if (deslizante && !reduzir) {
    let esperando = false;
    window.addEventListener(
      'scroll',
      () => {
        if (esperando) return;
        esperando = true;
        requestAnimationFrame(() => {
          const y = Math.min(window.scrollY, 900);
          deslizante.style.transform = `translateY(${y * 0.12}px)`;
          esperando = false;
        });
      },
      { passive: true },
    );
  }
</script>

<style is:global>
  /* Âncoras do menu não ficam escondidas atrás do cabeçalho fixo */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
