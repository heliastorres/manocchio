---
import '../styles/global.css';
import { conteudo } from '../data/conteudo';

const { site, acessibilidade } = conteudo;

// Endereços absolutos (as prévias exigem). Só existem quando o endereço final do site
// estiver definido em `site` no astro.config.mjs (etapa 9, ao publicar); até lá, o caminho relativo.
const canonico = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// Caminhos de arquivos da pasta public/ precisam levar a subpasta do site (base) na frente
const raiz = import.meta.env.BASE_URL.replace(/\/$/, '');
const imagemOg = Astro.site ? new URL(`${raiz}/og.jpg`, Astro.site).href : `${raiz}/og.jpg`;
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.descricao} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#141414" />
    {canonico && <link rel="canonical" href={canonico} />}
    <!-- Prévia ao compartilhar o link (Open Graph: WhatsApp, Facebook, LinkedIn; Twitter usa as mesmas) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={site.titulo} />
    <meta property="og:description" content={site.descricao} />
    <meta property="og:image" content={imagemOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.imagemOgAlt} />
    {canonico && <meta property="og:url" content={canonico} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${raiz}/favicon.svg`} />
    <link rel="icon" href={`${raiz}/favicon.ico`} />
    <title>{site.titulo}</title>
    <!-- Marca que o JavaScript está ativo: só então as partes da página começam escondidas e entram ao rolar -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Rede de segurança: se o script que revela as partes não rodar em 3 s, mostra tudo
      setTimeout(function () {
        document.documentElement.classList.add('js-falhou');
      }, 3000);
    </script>
  </head>
  <body class="bg-preto font-texto text-preto antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:bg-preto focus:px-4 focus:py-2 focus:text-branco"
    >
      {acessibilidade.pularParaConteudo}
    </a>
    <slot />
  </body>
</html>

<script>
  // ENTRADA DAS PARTES: cada elemento com data-revelar aparece uma vez, ao entrar na tela,
  // com um pequeno atraso por posição dentro da seção (título, texto, foto, um depois do outro).
  document.documentElement.classList.remove('js-falhou');
  const reduzir = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const itens = Array.from(document.querySelectorAll<HTMLElement>('[data-revelar]'));

  if (reduzir || !('IntersectionObserver' in window)) {
    itens.forEach((el) => el.classList.add('visivel'));
  } else {
    const contagem = new Map<Element, number>();
    itens.forEach((el) => {
      const secao = el.closest('section') ?? document.body;
      const n = contagem.get(secao) ?? 0;
      contagem.set(secao, n + 1);
      el.style.setProperty('--atraso', `${Math.min(n, 5) * 80}ms`);
    });
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visivel');
            observador.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
    );
    itens.forEach((el) => observador.observe(el));
  }
</script>

<style is:global>
  /* Âncoras do menu não ficam escondidas atrás do cabeçalho fixo */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
