---
import '../styles/global.css';
import { Image } from 'astro:assets';
import equipe from '../assets/fotos/equipe-ciclismo.webp';
import atleta from '../assets/fotos/atleta-capacete-verde.webp';
import piscinaNadoLivre from '../assets/fotos/piscina-nado-livre.webp';
import piscinaTresMarias from '../assets/fotos/piscina-tres-marias.webp';
import treinoNatacao from '../assets/fotos/treino-natacao.webp';
import guilherme from '../assets/fotos/guilherme-manocchio.webp';

const fotos = [
  { src: equipe, alt: 'Equipe Manocchio de ciclismo de braços erguidos na estrada' },
  { src: atleta, alt: 'Atleta de capacete verde pedalando em posição aerodinâmica' },
  { src: piscinaNadoLivre, alt: 'Atletas nadando na piscina do Nado Livre' },
  { src: piscinaTresMarias, alt: 'Piscina coberta com atletas treinando' },
  { src: treinoNatacao, alt: 'Duas nadadoras treinando com prancha' },
  { src: guilherme, alt: 'Guilherme Manocchio sorrindo com os braços abertos' },
];

const cores = [
  { nome: 'verde', hex: '#80b522', classe: 'bg-verde', texto: 'text-preto' },
  { nome: 'verde-escuro', hex: '#4e8221', classe: 'bg-verde-escuro', texto: 'text-branco' },
  { nome: 'preto', hex: '#141414', classe: 'bg-preto', texto: 'text-branco' },
  { nome: 'cinza-100', hex: '#f4f4f4', classe: 'bg-cinza-100', texto: 'text-preto' },
  { nome: 'cinza-300', hex: '#d4d4d4', classe: 'bg-cinza-300', texto: 'text-preto' },
  { nome: 'cinza-500', hex: '#808080', classe: 'bg-cinza-500', texto: 'text-preto' },
  { nome: 'cinza-700', hex: '#444444', classe: 'bg-cinza-700', texto: 'text-branco' },
];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Teste de identidade visual</title>
  </head>
  <body class="p-4 md:p-10 max-w-4xl mx-auto">
    <h1 class="font-titulo text-4xl font-bold text-verde-escuro mb-2">Teste de identidade visual</h1>
    <p class="mb-8 text-cinza-700">Página temporária da etapa 2, só para conferir cores, fontes e logos.</p>

    <h2 class="font-titulo text-2xl font-bold mb-3">Cores</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10">
      {cores.map((c) => (
        <li class={`${c.classe} ${c.texto} rounded p-4 h-24 flex flex-col justify-end text-sm`}>
          <strong>{c.nome}</strong>
          <span>{c.hex}</span>
        </li>
      ))}
    </ul>

    <h2 class="font-titulo text-2xl font-bold mb-3">Fontes</h2>
    <p class="font-titulo text-3xl font-bold mb-2">Roboto Condensed: títulos (font-titulo)</p>
    <p class="font-texto text-lg mb-10">Roboto: textos corridos (font-texto). Treinamento de triathlon, corrida, natação e ciclismo em Curitiba.</p>

    <h2 class="font-titulo text-2xl font-bold mb-3">Imagens tratadas (etapa 3)</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-10">
      {fotos.map((f) => (
        <li>
          <Image src={f.src} alt={f.alt} widths={[320, 640]} sizes="(min-width: 640px) 33vw, 50vw" class="w-full h-48 object-cover rounded" />
        </li>
      ))}
    </ul>

    <h2 class="font-titulo text-2xl font-bold mb-3">Logos</h2>
    <div class="flex flex-wrap gap-4">
      <div class="bg-cinza-100 p-6 rounded">
        <img src="/logos/logo-cor.png" width="150" height="141" alt="Logo Manocchio Sports (colorida)" />
      </div>
      <div class="bg-preto p-6 rounded">
        <img src="/logos/logo-branca.png" width="150" height="141" alt="Logo Manocchio Sports (branca)" />
      </div>
    </div>
  </body>
</html>
