---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Chamada from '../components/Chamada.astro';
import Apresentacao from '../components/Apresentacao.astro';
import Treinos from '../components/Treinos.astro';
import Planos from '../components/Planos.astro';
import Anamnese from '../components/Anamnese.astro';
import Comunicacao from '../components/Comunicacao.astro';
import Resultados from '../components/Resultados.astro';
import Inscricao from '../components/Inscricao.astro';
import Parceiros from '../components/Parceiros.astro';
import Locais from '../components/Locais.astro';
import Rodape from '../components/Rodape.astro';
import WhatsappFlutuante from '../components/WhatsappFlutuante.astro';
import BannerCookies from '../components/BannerCookies.astro';
---

<Base>
  <Cabecalho />
  <main id="conteudo" tabindex="-1" class="outline-none">
    <Chamada />
    <Apresentacao />
    <Treinos />
    <Planos />
    <Anamnese />
    <Comunicacao />
    <Resultados />
    <Inscricao />
    <Parceiros />
    <Locais />
  </main>
  <Rodape />
  <WhatsappFlutuante />
  <BannerCookies />
</Base>
