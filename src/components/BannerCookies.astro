---
// Banner de cookies só visual (RF6): o botão apenas fecha o aviso, não grava nada.
// Vidro: fundo translúcido com desfoque. O padding da direita deixa espaço para o botão do WhatsApp.
import { conteudo } from '../data/conteudo';

const { cookies } = conteudo;
---

<aside
  id="banner-cookies"
  aria-label={cookies.rotuloAcessibilidade}
  class="vidro fixed inset-x-0 bottom-0 z-50 text-branco"
>
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-4 pr-24 md:flex-row md:items-center md:px-8 md:pr-28">
    <div class="flex-1 text-base">
      {cookies.texto.map((p) => <p>{p}</p>)}
      <a href={cookies.politica.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-verde focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-branco">
        {cookies.politica.rotulo}
      </a>
    </div>
    <button
      type="button"
      id="banner-cookies-botao"
      class="botao bg-verde !py-2 text-preto hover:bg-branco"
    >
      {cookies.botao}
    </button>
  </div>
</aside>

<script>
  document.getElementById('banner-cookies-botao')?.addEventListener('click', () => {
    document.getElementById('banner-cookies')?.remove();
  });
</script>
