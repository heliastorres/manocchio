---
// Moldura comum das seções: id (âncora do menu), largura máxima e margens.
interface Props {
  id: string;
  titulo: string;
  fundo?: 'claro' | 'cinza' | 'escuro';
  centralizado?: boolean;
}
const { id, titulo, fundo = 'claro', centralizado = false } = Astro.props;

const fundos = {
  claro: 'bg-branco text-preto',
  cinza: 'bg-cinza-100 text-preto',
  escuro: 'bg-preto text-branco',
};
---

<section id={id} aria-labelledby={`${id}-titulo`} class={fundos[fundo]}>
  <div class="mx-auto max-w-6xl px-4 py-16 md:px-6 md:py-24">
    <h2
      id={`${id}-titulo`}
      class:list={[
        'font-titulo text-3xl font-bold uppercase leading-tight md:text-4xl',
        centralizado && 'text-center',
      ]}
    >
      {titulo}
    </h2>
    <div class:list={['mt-6', centralizado && 'mx-auto text-center']}>
      <slot />
    </div>
  </div>
</section>
