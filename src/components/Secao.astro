---
// Moldura comum das seções: id (âncora do menu), cor do fundo, margens iguais dos dois lados.
// O título (h2) fica por conta de cada seção, porque cada uma o posiciona de um jeito.
// O h2 precisa ter id={`${id}-titulo`}.
interface Props {
  id: string;
  fundo?: 'branco' | 'cinza' | 'preto' | 'verde' | 'verde-escuro';
  class?: string;
}
const { id, fundo = 'branco', class: extra = '' } = Astro.props;

const fundos = {
  branco: 'bg-branco text-preto',
  cinza: 'bg-cinza-100 text-preto',
  preto: 'bg-preto text-branco',
  verde: 'bg-verde text-preto',
  'verde-escuro': 'bg-verde-escuro text-branco',
};
---

<section id={id} aria-labelledby={`${id}-titulo`} class:list={['relative overflow-clip', fundos[fundo], extra]}>
  <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
    <slot />
  </div>
</section>
