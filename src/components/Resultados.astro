---
import { conteudo } from '../data/conteudo';
import Secao from './Secao.astro';
import Foto from './Foto.astro';

const { resultados } = conteudo;
---

<!-- Texto à esquerda e foto grande em folha à direita (o inverso da apresentação) -->
<Secao id={resultados.id} fundo="cinza">
  <div class="grid items-center gap-12 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-5">
      <h2 id="resultados-titulo" data-revelar class="titulo-secao">{resultados.titulo}</h2>
      <div class="mt-8 space-y-5">
        {resultados.texto.map((p) => <p data-revelar class="texto-corrido">{p}</p>)}
      </div>
    </div>
    <div class="md:col-span-7" data-revelar>
      <Foto
        imagem={resultados.imagem}
        widths={[640, 1000, 1400]}
        sizes="(min-width: 1280px) 720px, (min-width: 768px) 58vw, 100vw"
        class="folha aspect-[4/3] w-full object-cover"
      />
    </div>
  </div>
</Secao>
