---
import { conteudo } from '../data/conteudo';
import Botao from './Botao.astro';
import Foto from './Foto.astro';

const { chamada } = conteudo;
---

<section id={chamada.id} aria-labelledby="chamada-titulo" class="relative isolate flex min-h-[85vh] items-center overflow-hidden bg-preto pt-16 text-branco">
  <Foto
    imagem={chamada.imagem}
    widths={[640, 1024, 1600, 2000]}
    sizes="100vw"
    prioridade
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-50"
  />
  <div class="mx-auto w-full max-w-6xl px-4 py-20 md:px-6">
    <h1 id="chamada-titulo" class="max-w-3xl font-titulo text-4xl font-bold uppercase leading-tight sm:text-5xl md:text-6xl">
      {chamada.titulo}
    </h1>
    {chamada.texto.map((p) => <p class="mt-6 max-w-2xl text-lg md:text-xl">{p}</p>)}
    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
      <Botao href={chamada.botaoPrincipal.href}>{chamada.botaoPrincipal.rotulo}</Botao>
      <Botao href={chamada.botaoSecundario.href} variante="secundario">{chamada.botaoSecundario.rotulo}</Botao>
    </div>
  </div>
</section>
