---
import { conteudo } from '../data/conteudo';
import Secao from './Secao.astro';
import Botao from './Botao.astro';
import Foto from './Foto.astro';

const { inscricao } = conteudo;
---

<!-- Campo verde escuro: retrato do Head Coach em folha pequena (a foto só tem 418 px) e os passos -->
<Secao id={inscricao.id} fundo="verde-escuro">
  <h2 id="inscricao-titulo" data-revelar class="titulo-secao">{inscricao.titulo}</h2>
  <div class="mt-12 grid gap-12 md:mt-16 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-4">
      <div data-revelar class="max-w-xs">
        <Foto
          imagem={inscricao.imagem}
          widths={[240, 418]}
          sizes="(min-width: 768px) 320px, 70vw"
          class="folha aspect-square w-full object-cover"
        />
      </div>
      {inscricao.texto.map((p) => <p data-revelar class="texto-corrido mt-8">{p}</p>)}
    </div>
    <div class="md:col-span-8">
      <h3 data-revelar class="font-titulo text-linha font-bold uppercase leading-none">{inscricao.passosTitulo}</h3>
      <ol class="mt-8 list-decimal space-y-5 pl-8 marker:font-titulo marker:font-bold">
        {inscricao.passos.map((passo) => <li data-revelar class="texto-corrido pl-2">{passo}</li>)}
      </ol>
      <div data-revelar class="mt-10">
        <Botao href={inscricao.botao.href} variante="claro">{inscricao.botao.rotulo}</Botao>
      </div>
    </div>
  </div>
</Secao>
