---
import { conteudo } from '../data/conteudo';
import Secao from './Secao.astro';
import Foto from './Foto.astro';

const { apresentacao } = conteudo;
---

<!-- Foto vertical em folha à esquerda, título e texto à direita -->
<Secao id={apresentacao.id} fundo="branco">
  <div class="grid items-center gap-12 md:grid-cols-12 md:gap-16">
    <div class="md:col-span-5" data-revelar>
      <Foto
        imagem={apresentacao.imagem}
        widths={[480, 720, 1000]}
        sizes="(min-width: 1280px) 480px, (min-width: 768px) 42vw, 100vw"
        class="folha aspect-[4/5] w-full object-cover"
      />
    </div>
    <div class="md:col-span-7">
      <h2 id="apresentacao-titulo" data-revelar class="titulo-secao">{apresentacao.titulo}</h2>
      <div class="mt-8 max-w-2xl space-y-5">
        {apresentacao.texto.map((p) => <p data-revelar class="texto-corrido">{p}</p>)}
      </div>
    </div>
  </div>
</Secao>
