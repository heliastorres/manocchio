---
// Botão em forma de link. Links externos (https://...) abrem em outra aba.
// O formato (cantos de folha) está na classe "botao", em src/styles/global.css.
interface Props {
  href: string;
  variante?: 'primario' | 'secundario' | 'escuro' | 'claro';
  class?: string;
}
const { href, variante = 'primario', class: extra = '' } = Astro.props;
const externo = href.startsWith('http');

const estilos = {
  primario: 'bg-verde text-preto hover:bg-branco',
  // Sobre fundo escuro ou foto: preenchido de branco (sem contorno fino)
  secundario: 'bg-branco/15 text-branco hover:bg-branco hover:text-preto',
  escuro: 'bg-preto text-branco hover:bg-verde hover:text-preto',
  // Sobre verde ou verde escuro
  claro: 'bg-branco text-preto hover:bg-preto hover:text-branco',
};
---

<a
  href={href}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener noreferrer' : undefined}
  class:list={['botao', estilos[variante], extra]}
>
  <slot />
</a>
