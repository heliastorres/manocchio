---
import { conteudo } from '../data/conteudo';
import Secao from './Secao.astro';
import Botao from './Botao.astro';

const { planos } = conteudo;
---

<Secao id={planos.id} titulo={planos.titulo} fundo="cinza" centralizado>
  {planos.texto.map((p) => <p class="mx-auto max-w-3xl text-lg text-cinza-700">{p}</p>)}
  <ul class="mx-auto mt-10 grid max-w-3xl gap-6 text-left md:grid-cols-2">
    {
      planos.itens.map((plano) => (
        <li
          class:list={[
            'relative flex flex-col bg-branco p-8',
            plano.destaque ? 'border-4 border-verde' : 'border border-cinza-300',
          ]}
        >
          <h3 class="font-titulo text-2xl font-bold uppercase">{plano.nome}</h3>
          {plano.selo && (
            <span class="absolute -top-4 left-8 bg-verde px-3 py-1 font-titulo text-sm font-bold uppercase tracking-wide text-preto">
              {plano.selo}
            </span>
          )}
          <p class="mt-3 flex-1 text-cinza-700">{plano.descricao}</p>
          <Botao href={plano.botao.href} variante={plano.destaque ? 'primario' : 'escuro'} class="mt-6">
            {plano.botao.rotulo}
          </Botao>
        </li>
      ))
    }
  </ul>
</Secao>
