---
import { conteudo } from '../data/conteudo';
import Secao from './Secao.astro';
import Botao from './Botao.astro';

const { planos } = conteudo;
---

<!-- Planos "que sobem": dois blocos de cores lisas, o recomendado é mais alto -->
<Secao id={planos.id} fundo="cinza">
  <h2 id="planos-titulo" data-revelar class="titulo-secao">{planos.titulo}</h2>
  <div class="mt-12 grid gap-12 md:mt-16 lg:grid-cols-12 lg:items-end lg:gap-12">
    <div class="lg:col-span-5">
      {planos.texto.map((p) => <p data-revelar class="texto-corrido">{p}</p>)}
    </div>

    <ul class="grid items-end gap-4 sm:grid-cols-2 lg:col-span-7">
      {
        planos.itens.map((plano) => (
          <li
            data-revelar
            class:list={[
              'folha-suave flex flex-col p-8',
              plano.destaque ? 'bg-verde text-preto sm:min-h-[27rem]' : 'bg-preto text-branco sm:min-h-[21rem]',
            ]}
          >
            <h3 class="font-titulo text-linha font-bold uppercase leading-none">{plano.nome}</h3>
            {plano.selo && (
              <p class="mt-3 flex items-center gap-2 font-titulo text-lg font-bold uppercase">
                <span class="marcador"></span>
                {plano.selo}
              </p>
            )}
            <p class="mt-4 flex-1 text-lg">{plano.descricao}</p>
            <Botao href={plano.botao.href} variante={plano.destaque ? 'escuro' : 'primario'} class="mt-8">
              {plano.botao.rotulo}
            </Botao>
          </li>
        ))
      }
    </ul>
  </div>
</Secao>
